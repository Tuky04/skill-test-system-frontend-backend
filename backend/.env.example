NODE_ENV=development
HOST=127.0.0.1
PORT=5000
APP_TIMEZONE=Asia/Bangkok
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
UPLOAD_DIR=D:/Xampp/skill-test-system-data/private_uploads

DB_HOST=localhost
# พอร์ตฐานข้อมูล (ค่าเริ่มต้น 3306) เปลี่ยนเมื่อเซิร์ฟเวอร์ฐานข้อมูลใช้พอร์ตอื่น
DB_PORT=3306
DB_USER=skill_test_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=skill_test_system
# ขนาด pool และเพดานคิวรอ connection (เกินเพดานคำขอจะได้ error เร็ว แทนการค้างและกินหน่วยความจำ)
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=200
# บังคับ STRICT SQL mode ต่อ session (XAMPP/MariaDB ค่าเริ่มต้นไม่เปิด: ข้อมูลยาวเกินจะถูกตัดเงียบ ๆ) ตั้ง false เพื่อปิด
DB_STRICT_MODE=true

# สร้างด้วยตัวสร้างค่าสุ่มเข้ารหัส ความยาวอย่างน้อย 32 ตัวอักษร และห้ามใช้ค่าตัวอย่างนี้
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
REQUIRE_EMAIL_VERIFICATION=true
PRIVACY_POLICY_VERSION=1.0

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-app-password
TEST_EMAIL_TO=you@example.com
STAFF_EMAIL=staff@example.com



ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-one-time-password

# ใช้ครั้งเดียวกับ npm run create-staff แล้วลบออกจาก .env
STAFF_INITIAL_USERNAME=staff
STAFF_INITIAL_EMAIL=staff@example.com
STAFF_INITIAL_PASSWORD=replace-with-a-strong-one-time-password
# ── ค่าสมัครสอบ (โอนเงินแล้วแนบสลิป เจ้าหน้าที่ตรวจ ไม่มีการคืนเงิน สอบซ่อมต้องชำระใหม่) ──
PAYMENT_AMOUNT=100
# บัญชีรับเงินของหน่วยงาน (ปล่อยว่างได้ ระบบจะแจ้งผู้สมัครว่ายังไม่ได้ตั้งค่า ต้องกรอกก่อนเปิดรับสมัครจริง)
PAYMENT_ACCOUNT_NAME=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_PROMPTPAY_ID=
PAYMENT_NOTE=

# ── Rate limit (ค่า <= 0 = ปิดตัวจำกัดนั้น ใช้เฉพาะตอนพัฒนา/ทดสอบ) ──
# เข้าสู่ระบบ: นับเฉพาะครั้งที่ล้มเหลว ใน 15 นาที (ต่อ IP และต่อชื่อบัญชี)
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
# ต่อ IP ใน 1 ชั่วโมง (แยกตัวนับกัน) — คอมพิวเตอร์ห้องแล็บ/NAT ของมหาวิทยาลัยใช้ IP เดียวกันหลายคน ปรับให้พอดีกับสถานที่จริง
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_RESEND_MAX=5
# เพดานรวมทั้ง API ต่อ IP ต่อนาที
RATE_LIMIT_API_MAX=1200

# ── ส่งออกไฟล์ Excel (สร้างใน worker thread) ──
EXPORT_MAX_ROWS=50000
EXPORT_MAX_CONCURRENT=2
