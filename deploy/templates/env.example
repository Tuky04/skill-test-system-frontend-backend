# ═══════════════════════════════════════════════════════════════════
# ค่าตั้งค่าระบบ — คัดลอกไฟล์นี้เป็น  app/.env  แล้วแก้ค่าให้ครบ
# ห้ามส่งไฟล์ .env ให้ผู้อื่น และห้ามนำขึ้น Git (มีรหัสผ่านฐานข้อมูลและกุญแจลับ)
# หลังแก้ไฟล์นี้ต้องหยุดแล้วเปิดระบบใหม่
# ═══════════════════════════════════════════════════════════════════

# ── เครือข่าย ───────────────────────────────────────────────────────
NODE_ENV=production
# พอร์ตที่สถานศึกษากำหนดให้ (ระบบทั้งหมดอยู่ที่พอร์ตเดียว: หน้าเว็บ + API)
PORT=8080
# 0.0.0.0 = เครื่องอื่นในเครือข่ายเข้าได้ / 127.0.0.1 = เข้าได้เฉพาะเครื่องนี้ (ใช้เมื่อมี Nginx/Apache อยู่หน้า)
HOST=0.0.0.0
# ที่อยู่ที่ผู้ใช้พิมพ์เข้ามาจริง (ใช้สร้างลิงก์ในอีเมล) ไม่ต้องมี / ท้าย  เช่น http://10.1.2.3:8080 หรือ https://skilltest.example.ac.th
PUBLIC_APP_URL=http://เปลี่ยนเป็น-ip-หรือโดเมน:8080
# เข้าผ่าน HTTP ล้วน (ไม่มี HTTPS) = false  /  เข้าผ่าน HTTPS = true
# ถ้าตั้งผิด (HTTP แต่เป็น true) ผู้ใช้จะถูกเด้งออกจากระบบทุก 15 นาที
COOKIE_SECURE=false
# จำนวนตัวกลางที่อยู่หน้าระบบ: เปิดตรง = 0 / มี Nginx หรือ Apache 1 ตัว = 1 (ใช้นับ IP ผู้ใช้ให้ถูกต้องสำหรับ rate limit)
TRUST_PROXY_HOPS=0
# เว็บอื่นที่ได้รับอนุญาตให้เรียก API (คั่นด้วยจุลภาค) เว้นว่างได้ถ้าเปิดหน้าเว็บจากที่อยู่เดียวกับ API
CORS_ORIGINS=

# ── ไฟล์ (เส้นทางสัมพัทธ์จากโฟลเดอร์ app) ───────────────────────────
# โฟลเดอร์หน้าเว็บที่ build แล้ว (ให้ backend เสิร์ฟเอง)
FRONTEND_DIR=../web
# ที่เก็บเอกสารที่นักศึกษาอัปโหลด (มีสำเนาบัตรประชาชน) ต้องสำรองข้อมูลและห้ามเปิดให้เว็บเข้าถึงตรง
UPLOAD_DIR=../data/private_uploads
APP_TIMEZONE=Asia/Bangkok

# ── ฐานข้อมูล MariaDB / MySQL ───────────────────────────────────────
DB_HOST=localhost
# พอร์ตของฐานข้อมูล (ค่าเริ่มต้น 3306) เปลี่ยนเมื่อเซิร์ฟเวอร์ฐานข้อมูลใช้พอร์ตอื่น
DB_PORT=3306
DB_USER=skill_test_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=skill_test_system
DB_CONNECTION_LIMIT=10

# ── ความปลอดภัย ─────────────────────────────────────────────────────
# สร้างด้วยคำสั่ง:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# รันสองครั้ง ใส่คนละค่า ยาวอย่างน้อย 32 ตัวอักษร ห้ามใช้ค่าตัวอย่างนี้
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
PRIVACY_POLICY_VERSION=1.0

# ── อีเมล ───────────────────────────────────────────────────────────
# true = นักศึกษาต้องกดลิงก์ยืนยันอีเมลก่อนเข้าสู่ระบบ (แนะนำ) ต้องตั้ง SMTP ให้ใช้งานได้
# false = ไม่บังคับ (เหมาะกับการทดลองเท่านั้น)
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
# ผู้รับอีเมลแจ้งเตือนเมื่อมีนักศึกษาสมัครสอบใหม่
STAFF_EMAIL=staff@example.com
TEST_EMAIL_TO=your-email@example.com

# ── ค่าสมัครสอบ (โอนเงินแล้วแนบสลิป เจ้าหน้าที่ตรวจ ไม่มีการคืนเงิน สอบซ่อมต้องชำระใหม่) ──
PAYMENT_AMOUNT=100
# บัญชีรับเงินของหน่วยงาน (ปล่อยว่างได้ ระบบจะแจ้งผู้สมัครว่ายังไม่ได้ตั้งค่า ต้องกรอกก่อนเปิดรับสมัครจริง)
PAYMENT_ACCOUNT_NAME=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_PROMPTPAY_ID=
PAYMENT_NOTE=

# ── Rate limit และการส่งออก (ปรับได้ตามจำนวนผู้ใช้ในเครือข่ายเดียวกัน) ──
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_RESEND_MAX=5
RATE_LIMIT_API_MAX=1200
EXPORT_MAX_ROWS=50000
EXPORT_MAX_CONCURRENT=2

# ── สร้างบัญชีแรก (ใช้กับ npm run create-admin / create-staff ครั้งเดียว แล้วลบออกจากไฟล์นี้) ──
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
STAFF_INITIAL_USERNAME=staff01
STAFF_INITIAL_EMAIL=staff@example.com
STAFF_INITIAL_PASSWORD=
