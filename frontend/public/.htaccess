Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /skill-test-system/frontend/build/

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Let React Router handle direct links such as /login and /student-dashboard.
    RewriteRule . index.html [L]
</IfModule>
